{
  "name": "legal-ai-system",
  "version": "1.0.0",
  "description": "Legal AI System with Microservices Architecture",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:gateway\" \"npm run dev:auth\" \"npm run dev:client\"",
    "dev:auth": "cd services/auth-service && npm run dev",
    "dev:gateway": "cd services/api-gateway && npm run dev",
    "dev:client": "next dev",
    "install:all": "npm install && cd services/auth-service && npm install && cd ../api-gateway && npm install",
    "build": "next build",
    "start": "next start",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [
    "microservices",
    "legal-ai"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.6.2",
    "dotenv": "^17.3.1",
    "next": "^14.0.4",
    "pg": "^8.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/react": "19.2.14",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "eslint-config-next": "^14.0.4"
  }
}
