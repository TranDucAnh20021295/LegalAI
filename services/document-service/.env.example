PORT=5002
DB_HOST=localhost
DB_PORT=5432
DB_NAME=legal_ai
DB_USER=postgres
DB_PASSWORD=10092002

# Embedding (bắt buộc cho tra cứu AI): chọn 1 trong 2
# Lưu ý: GEMINI_API_KEY (chat) không dùng ở đây — Gemini không tạo vector trong stack này.
#
# Cách 1 — OpenAI (1536 chiều, cột embedding trong DocumentChunks)
#   Có thể bỏ trống ở đây nếu đã có OPENAI_API_KEY trong services/chat-service/.env
#   (document-service tự đọc thêm file đó khi khởi động).
OPENAI_API_KEY=
# EMBEDDING_PROVIDER=openai
#
# Cách 2 — sentence-transformers (local), không tốn OpenAI (768 chiều, cột embedding_768)
#   Không có OPENAI_API_KEY → document-service mặc định coi như local (trừ khi set EMBEDDING_PROVIDER=openai).
#   Terminal 1: cd services/embedding-service && pip install -r requirements.txt && python app.py
#   Trong .env document-service:
# EMBEDDING_PROVIDER=local
# EMBEDDING_LOCAL_URL=http://localhost:5004
#
# Lưu ý: nếu không set OPENAI_API_KEY và không chạy embedding-service → tra cứu AI sẽ lỗi 503.

# Bật mới tự embed toàn bộ DB khi khởi động (mặc định tắt)
# AUTO_SYNC_CHUNKS_ON_STARTUP=true
